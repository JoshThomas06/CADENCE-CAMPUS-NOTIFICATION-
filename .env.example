# ==============================================================================
# Cadence Campus Pulse — Environment Configuration Template
# ==============================================================================
# NOTE: All variables below are 100% OPTIONAL for local development.
# The platform includes an embedded SQLite ACID engine and in-memory fallback broker,
# allowing the entire system to boot out of the box with zero configuration!
# ==============================================================================

# Database Persistence (Optional: defaults to native SQLite in services/shared/data/)
# If you run PostgreSQL via Docker or locally:
DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campus_db?schema=public"

# System Ports (Optional: defaults shown below)
PORT=4000
GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
CLASS_SERVICE_PORT=4002
EXAM_SERVICE_PORT=4003
EVENT_SERVICE_PORT=4004
NOTIFICATION_PORT=4005
FRONTEND_PORT=3000

# Kafka Broker (Optional: defaults to in-memory EventBus if Kafka is offline)
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="cadence-campus-pulse"

# Real SMTP / Nodemailer Delivery (Optional: defaults to ephemeral Ethereal testing)
# To forward real emails and Telco SMS to real inboxes, supply a Gmail App Password:
# REAL_SMTP_HOST="smtp.gmail.com"
# REAL_SMTP_PORT=465
# REAL_SMTP_SECURE=true
# REAL_SMTP_USER="your-email@gmail.com"
# REAL_SMTP_PASS="xxxx xxxx xxxx xxxx"
# REAL_SMTP_FROM="Cadence Alerts <your-email@gmail.com>"
