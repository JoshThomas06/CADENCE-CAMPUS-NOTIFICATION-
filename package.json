{
  "name": "campus-pulse-platform",
  "version": "1.0.0",
  "description": "Event-Driven Campus Notification & Alert Platform using Kafka and Microservices",
  "scripts": {
    "setup": "npm install && npm install --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend",
    "start:gateway": "node gateway/src/index.js",
    "start:users": "node services/user-service/src/index.js",
    "start:classes": "node services/class-service/src/index.js",
    "start:exams": "node services/exam-service/src/index.js",
    "start:events": "node services/event-service/src/index.js",
    "start:notifications": "node services/notification-service/src/index.js",
    "start:all": "node scripts/start-all.js",
    "start:frontend": "npm run dev --prefix frontend",
    "dev:all": "node scripts/start-everything.js",
    "build:frontend": "npm run build --prefix frontend",
    "test:phase1": "node tests/test_phase1.js",
    "test:phase2": "node tests/test_phase2.js",
    "test:phase3": "node tests/test_phase3.js",
    "test:e2e": "node tests/test_e2e.js",
    "test:database": "node tests/test_database_crud.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "nodemailer": "^6.10.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7"
  }
}
