# ==============================================================================
# Cadence Campus Pulse — Git Ignore Rules
# ==============================================================================

# Node dependencies (install via `npm run setup` or `npm install`)
node_modules/
frontend/node_modules/

# Production frontend build artifacts (built via `npm run build:frontend`)
frontend/dist/
dist/

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary test / task artifacts
scratch/
.tmp/
temp/
